      },
      "__schema1": {
        "$ref": "#/$defs/__schema2",
        "default": false,
        "description": "Add core-only mapping candidates through caller-supplied GDB/pwndbg"
      },
      "__schema2": {
        "type": "boolean"
      }
    },
