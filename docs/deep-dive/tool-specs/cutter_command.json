    "accessesNetwork": true,
    "changesUiState": true,
    "executesForeignCode": true,
    "idempotent": false,
    "launchesProcess": true,
    "mayDiscardData": false,
    "mutatesDevice": false,
    "mutatesSession": true,
    "mutatesTarget": true,
    "writesFilesystem": true
  },
