        "minLength": 1,
        "type": "string"
      },
      "__schema1": {
        "additionalProperties": false,
        "properties": {
          "address": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "certificate": {
            "minLength": 1,
            "type": "string"
          },
          "keepalive_interval": {
            "description": "Remote keepalive interval in seconds",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "origin": {
            "minLength": 1,
            "type": "string"
          },
          "token": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "address"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
