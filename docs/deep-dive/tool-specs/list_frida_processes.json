          "type": "object"
        },
        "type": "array"
      },
      "__schema2": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "$id": "urn:rea:tool-output:sha256:8cf5d2e5bcf5cf0eedee3ebacd1339e7263189a08be49e9f2c966b20814b920a",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
