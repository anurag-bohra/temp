        "$ref": "#/$defs/__schema0"
      },
      "remote": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "type": "object"
  },
  "kind": "native-provider",
  "name": "list_frida_processes",
  "outputSchema": {
    "$defs": {
      "__schema0": {
        "type": "string"
      },
      "__schema1": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "identifier": {
              "anyOf": [
