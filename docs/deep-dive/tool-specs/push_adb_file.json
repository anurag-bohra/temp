    "accessesNetwork": true,
    "changesUiState": false,
    "executesForeignCode": false,
    "idempotent": false,
    "launchesProcess": true,
    "mayDiscardData": false,
    "mutatesDevice": true,
    "mutatesSession": true,
    "mutatesTarget": true,
    "writesFilesystem": true
  },
