        "type": "string"
      },
      "__schema2": {
        "$ref": "#/$defs/__schema3",
        "description": "Additional absolute UTF-8 JavaScript files recovered together with path; each is snapshotted separately so imports can resolve across related chunks. All inputs share a 64 MiB total budget"
