{
  "version": 1,
  "note": "Indicative rules over Evidence-derived Facts. ATT&CK ids are an indicative mapping to be reviewed by an analyst; a match is a static indicator, not a verdict.",
  "rules": [
    { "id": "NET-001", "title": "Hard-coded routable network endpoint", "tactic": "command-and-control", "attack": ["T1071"], "severity": "medium", "when": { "ioc": { "kinds": ["url", "domain", "ipv4"], "classification_not": ["loopback", "private", "link-local", "reserved"] } } },
    { "id": "NET-002", "title": "Outbound connection or HTTP client API", "tactic": "command-and-control", "attack": ["T1071"], "severity": "low", "when": { "api_any": ["connect", "WSAConnect", "InternetOpenA", "InternetOpenW", "HttpClient", "System.Net.Http.HttpClient::GetStringAsync", "GetStringAsync", "HttpWebRequest", "WebClient", "HttpURLConnection", "https.request", "http.request", "fetch"] } },
    { "id": "NET-003", "title": "Beacon pattern: periodic timer plus network request (JavaScript)", "tactic": "command-and-control", "attack": ["T1071"], "severity": "medium", "when": { "all": [{ "api_any": ["setInterval"] }, { "sink": { "kind": "network-request" } }] } },
    { "id": "NET-004", "title": "Tool/payload download then execution pattern", "tactic": "command-and-control", "attack": ["T1105"], "severity": "high", "when": { "all": [{ "any": [{ "api_any": ["GetStringAsync", "DownloadFile", "DownloadString", "URLDownloadToFileA", "URLDownloadToFileW", "curl_easy_perform"] }, { "sink": { "kind": "network-request" } }] }, { "any": [{ "api_any": ["System.Diagnostics.Process::Start", "Process::Start", "CreateProcessA", "CreateProcessW", "ShellExecuteA", "WinExec", "execve", "system"] }, { "sink": { "kind": "child-process" } }, { "sink": { "kind": "eval" } }] }] } },
    { "id": "EXEC-001", "title": "Process creation API", "tactic": "execution", "attack": ["T1059"], "severity": "low", "when": { "api_any": ["System.Diagnostics.Process::Start", "Process::Start", "CreateProcessA", "CreateProcessW", "ShellExecuteA", "ShellExecuteW", "WinExec", "execve", "execl", "execv", "system", "popen", "posix_spawn", "child_process"] } },
    { "id": "EXEC-002", "title": "Reverse-shell shape: socket connect plus descriptor redirection", "tactic": "execution", "attack": ["T1059"], "severity": "high", "when": { "api_all": ["dup2", "connect"] } },
    { "id": "EXEC-003", "title": "Renderer-controlled data reaches a child process (Electron IPC to exec)", "tactic": "execution", "attack": ["T1059"], "severity": "high", "when": { "sink": { "kind": "child-process", "taint_source": "ipc-argument" } } },
    { "id": "EXEC-004", "title": "Dynamic evaluation of network-derived data", "tactic": "execution", "attack": ["T1059", "T1620"], "severity": "high", "when": { "sink": { "kind": "eval", "taint_source": "network-response" } } },
    { "id": "EXEC-005", "title": "Child-process sink present (command not statically resolved)", "tactic": "execution", "attack": ["T1059"], "severity": "low", "when": { "sink": { "kind": "child-process" } } },
    { "id": "EXEC-006", "title": "eval / Function constructor present", "tactic": "execution", "attack": ["T1059"], "severity": "low", "when": { "any": [{ "sink": { "kind": "eval" } }, { "sink": { "kind": "function-constructor" } }] } },
    { "id": "INJ-001", "title": "Executable memory allocation or remote-memory API (loader/injection pattern)", "tactic": "defense-evasion", "attack": ["T1055"], "severity": "high", "when": { "api_any": ["VirtualAlloc", "VirtualAllocEx", "WriteProcessMemory", "CreateRemoteThread", "NtWriteVirtualMemory", "QueueUserAPC", "SetThreadContext"] } },
    { "id": "INJ-002", "title": "Memory protection change (possible unpacking/injection)", "tactic": "defense-evasion", "attack": ["T1055", "T1027"], "severity": "low", "when": { "api_any": ["mprotect", "VirtualProtect", "VirtualProtectEx"] } },
    { "id": "EVA-001", "title": "Anti-debugging API", "tactic": "defense-evasion", "attack": ["T1622"], "severity": "medium", "when": { "api_any": ["ptrace", "IsDebuggerPresent", "CheckRemoteDebuggerPresent", "NtQueryInformationProcess", "OutputDebugStringA"] } },
    { "id": "OBF-001", "title": "Base64/hex decoding in code or decoded indicator", "tactic": "defense-evasion", "attack": ["T1140", "T1027"], "severity": "low", "when": { "any": [{ "api_any": ["FromBase64String", "atob", "b64decode", "base64_decode"] }, { "sink": { "kind": "base64-decode" } }, { "ioc": { "decoded": true } }] } },
    { "id": "OBF-002", "title": "High-entropy section (packed/encrypted data)", "tactic": "defense-evasion", "attack": ["T1027"], "severity": "medium", "when": { "feature": { "max_section_entropy_gt": 7.2 } } },
    { "id": "OBF-003", "title": "Large overlay appended to a PE (embedded payload candidate)", "tactic": "defense-evasion", "attack": ["T1027"], "severity": "low", "when": { "feature": { "overlay_bytes_gt": 65536 } } },
    { "id": "STG-001", "title": "Embedded non-icon PE resource (payload staging candidate)", "tactic": "defense-evasion", "attack": ["T1027"], "severity": "medium", "when": { "tag_any": ["pe-rcdata-resource"] } },
    { "id": "STG-002", "title": "Managed P/Invoke to native memory APIs", "tactic": "defense-evasion", "attack": ["T1055"], "severity": "medium", "when": { "all": [{ "tag_any": ["pinvoke"] }, { "api_any": ["VirtualAlloc", "CreateRemoteThread", "WriteProcessMemory"] }] } },
    { "id": "PER-001", "title": "Autorun registry key reference", "tactic": "persistence", "attack": ["T1547.001"], "severity": "medium", "when": { "ioc": { "kinds": ["registry-key"], "value_regex": "(?i)\\\\(Run|RunOnce)\\b" } } },
    { "id": "DIS-001", "title": "Host and user discovery APIs (information gathering)", "tactic": "discovery", "attack": ["T1082", "T1033"], "severity": "low", "when": { "api_any": ["gethostname", "GetComputerNameA", "GetComputerNameW", "GetUserNameA", "GetUserNameW", "os.hostname", "os.userInfo", "Environment::MachineName", "Environment::UserName"] } },
    { "id": "MOB-001", "title": "SMS send permission", "tactic": "impact", "attack": ["T1582"], "severity": "high", "when": { "permission_any": ["android.permission.SEND_SMS"] } },
    { "id": "MOB-002", "title": "SMS read/receive permission", "tactic": "collection", "attack": ["T1636.004"], "severity": "medium", "when": { "permission_any": ["android.permission.READ_SMS", "android.permission.RECEIVE_SMS"] } },
    { "id": "MOB-003", "title": "Accessibility or overlay abuse permissions", "tactic": "collection", "attack": ["T1417"], "severity": "medium", "when": { "permission_any": ["android.permission.BIND_ACCESSIBILITY_SERVICE", "android.permission.SYSTEM_ALERT_WINDOW"] } },
    { "id": "ELE-001", "title": "Electron window with nodeIntegration enabled", "tactic": "privilege-escalation", "attack": ["T1059"], "severity": "medium", "when": { "electron": { "window_nodeIntegration": true } } },
    { "id": "ELE-002", "title": "Electron window without contextIsolation", "tactic": "privilege-escalation", "attack": [], "severity": "low", "when": { "electron": { "window_contextIsolation": false } } },
    { "id": "ELE-003", "title": "IPC handler without sender validation", "tactic": "privilege-escalation", "attack": [], "severity": "medium", "when": { "electron": { "ipc_without_sender_validation": true } } },
    { "id": "ARC-001", "title": "Archive path traversal or symlink escape entries", "tactic": "defense-evasion", "attack": [], "severity": "high", "when": { "anomaly_any": ["path-traversal", "absolute-path", "symlink-escape"] } },
    { "id": "ARC-002", "title": "Archive compression-bomb or quota anomaly", "tactic": "impact", "attack": [], "severity": "medium", "when": { "anomaly_any": ["compression-ratio", "entry-count", "total-size", "nesting-depth", "size-mismatch"] } },
    { "id": "SIG-001", "title": "YARA rule match", "tactic": "detection", "attack": [], "severity": "medium", "when": { "yara_any": ["*"] } },
    { "id": "HRD-001", "title": "Weak binary hardening (no stack canary and executable stack)", "tactic": "vuln-surface", "attack": [], "severity": "info", "when": { "feature": { "hardening_weak": true } } },
    { "id": "SBX-001", "title": "Sandboxed run observed process, file or network activity", "tactic": "execution", "attack": [], "severity": "info", "when": { "tag_any": ["sandbox-ran"] } },
    { "id": "SBX-002", "title": "Sample attempted outbound network connections in the sandbox", "tactic": "command-and-control", "attack": ["T1071"], "severity": "medium", "when": { "tag_any": ["sandbox-network-attempt"] } },
    { "id": "WEB-001", "title": "Page attempted requests to non-allowlisted hosts (blocked)", "tactic": "command-and-control", "attack": [], "severity": "medium", "when": { "tag_any": ["web-blocked-requests"] } }
  ]
}
